{
  "_comment": "Branch protection rules for main. Applied by scripts/apply-branch-protection.sh via `gh api`. Keep in sync with .github/workflows/*.yml — every required status check here must be the name of a job that runs on push/PR to main.",
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "lint",
      "typecheck",
      "test",
      "pre-commit",
      "claude-review"
    ]
  },
  "enforce_admins": false,
  "required_pull_request_reviews": {
    "required_approving_review_count": 1,
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": false,
    "require_last_push_approval": true
  },
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "block_creations": false,
  "required_conversation_resolution": true,
  "lock_branch": false,
  "allow_fork_syncing": true,
  "required_signatures": false
}
