---
/**
 * 404.astro — not-found page
 *
 * Minimal, on-brand. One sentence that tells the visitor what happened,
 * two links back into the site. No humor, no clever copy — keep the
 * register flat so the page reads as a system response, not marketing.
 */
import Base from '../layouts/Base.astro';
---

<Base
  title="Not found"
  description="The page you requested isn't here."
  robots="noindex, follow"
>
  <section class="container container--dense section">
    <p class="t-caption">404</p>
    <h1 class="t-h1">Not here.</h1>
    <p class="lede">
      The page you requested doesn't exist on this site. It may have moved,
      or the link that brought you here may be wrong.
    </p>
    <p>
      <a class="cta" href="/">Back to home</a>
      &nbsp;
      <a class="cta cta--ghost" href="/dense">Dense</a>
    </p>
  </section>
</Base>

<style>
  .lede {
    color: var(--steel);
    font-size: var(--fs-body-lg);
    max-width: 56ch;
    margin-block: 1rem 2rem;
  }
</style>
